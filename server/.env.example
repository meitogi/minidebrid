# Alldebrid API key — https://alldebrid.com/apikeys/ . Only this server ever uses it.
ALLDEBRID_APIKEY=

# Signs the stream (VLC) links. Never given to a device : adding or revoking a token leaves
# every link valid. Unset → APP_TOKEN signs them (setting it later invalidates those links).
# Generate with: openssl rand -hex 32
STREAM_SECRET=

# Optional : one implicit access token, listed as "default" by `wtf debrid token list`.
# Device tokens live in data/tokens.json, managed with `wtf debrid token add|list|revoke`.
# Revoke this one by removing it here and restarting the server. Generate with: openssl rand -hex 32
APP_TOKEN=

# Public base URL of the stream links (Traefik → frps:8097 → frpc → this server).
PUBLIC_URL=https://debrid.du.ranchchoco.boo

# Signaling relay on the VPS.
RELAY_URL=wss://signal.du.ranchchoco.boo

# Port of the stream HTTP server inside the container (frpc localPort).
HTTP_PORT=8098

# UDP range for WebRTC ICE, published as-is by deploy/compose.yml.
ICE_PORTS=50000-50019

# Optional : the token store (default data/tokens.json next to this file).
# TOKENS_FILE=

# Optional : base URL of the setup links printed by `wtf debrid token` (default the Pages webapp).
# WEBAPP_URL=https://meitogi.github.io/minidebrid/
