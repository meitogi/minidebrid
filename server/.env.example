# Alldebrid API key — https://alldebrid.com/apikeys/ . Only this server ever uses it.
ALLDEBRID_APIKEY=

# Shared secret pasted into the webapp. Derives the server's peer id, authenticates
# the DataChannel and signs the stream links. Generate with: openssl rand -hex 32
APP_TOKEN=

# Public base URL of the stream links (Traefik → frps:8097 → frpc → this server).
PUBLIC_URL=https://debrid.du.ranchchoco.boo

# Signaling relay on the VPS.
RELAY_URL=wss://signal.du.ranchchoco.boo

# Port of the stream HTTP server inside the container (frpc localPort).
HTTP_PORT=8098

# UDP range for WebRTC ICE, published as-is by deploy/compose.yml.
ICE_PORTS=50000-50019
